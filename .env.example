# Server
PORT=3001
CLIENT_URL=http://localhost:5173

# Database
DATABASE_URL="file:./prisma/dev.db"

# AI（可选；未配置时使用本地规则）
AI_BASE_URL=https://api.siliconflow.cn/v1
AI_API_KEY=
AI_MODEL=Qwen/Qwen3-8B

# GitHub（可选；配置后可提高请求限额）
GITHUB_TOKEN=

# 自动采集
COLLECTION_SCHEDULE_ENABLED=false
COLLECTION_CRON=0 */2 * * *

# 每日/每周邮件摘要
DIGEST_SCHEDULE_ENABLED=false
DIGEST_DAILY_CRON=0 8 * * *
DIGEST_WEEKLY_CRON=0 9 * * 1
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
NOTIFY_EMAIL=
