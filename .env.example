# Server
PORT=3001
CLIENT_URL=http://localhost:5173
TRUST_PROXY=false
ADMIN_USERNAME=admin
# 必填：填写你指定的完整管理员密码（至少12字符，保留结尾标点）
ADMIN_PASSWORD=
SESSION_SECRET=replace-with-a-long-random-secret

# Database
DATABASE_URL="file:./prisma/dev.db"
# Docker：旧部署若使用仓库的 ./data 目录，取消下一行注释以继续挂载原数据库
# SIGNALDOCK_DATA_PATH=./data

# AI（可选；未配置时使用本地规则）
AI_BASE_URL=https://api.siliconflow.cn/v1
AI_API_KEY=
AI_MODEL=Qwen/Qwen3-8B
AI_TIMEOUT_MS=12000
AI_MAX_RETRIES=2
AI_CONCURRENCY=3
AI_DAILY_LIMIT=300
BRIEF_DAILY_LIMIT=30

# GitHub（可选；配置后可提高请求限额）
GITHUB_TOKEN=

# 自动采集
COLLECTION_SCHEDULE_ENABLED=false
COLLECTION_CRON=0 */2 * * *

# 每日/每周邮件摘要
DIGEST_SCHEDULE_ENABLED=false
DIGEST_DAILY_CRON=0 8 * * *
DIGEST_WEEKLY_CRON=0 9 * * 1
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
NOTIFY_EMAIL=
