# ===== SignalDock 生产环境配置（腾讯云后端）=====
# 复制为 server/.env 后填写；容器内 DATABASE_URL 已由 Dockerfile/编排覆盖为 file:/data/signaldock.db

PORT=8080

# 允许访问的前端来源，多个用英文逗号分隔（Vercel 正式域名 + 预览域名可用 * 兜底）
CLIENT_URL=https://signaldock.vercel.app,https://signaldock-git-main-xxx.vercel.app

# 是否放行任意 *.vercel.app 预览域名
ALLOW_VERCEL_PREVIEW=true

# 数据库：容器内必须指向持久化卷 /data
DATABASE_URL=file:/data/signaldock.db

# AI 摘要：不填 Key 会走本地 fallback，功能仍可用
AI_BASE_URL=https://api.siliconflow.cn/v1
AI_API_KEY=
AI_MODEL=Qwen/Qwen3-8B

# 可选：GitHub 采集提高限额
GITHUB_TOKEN=

# 可选：邮件通知
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL=
